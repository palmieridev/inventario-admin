---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Acceso al negocio · Inventario Admin">
  <main class="acceso contenedor">
    <div class="acceso-encabezado">
      <p class="marca">Inventario Admin</p>
      <h1>Acceso al negocio</h1>
    </div>

    <form id="inicio-sesion" class="panel formulario" method="post">
      <p id="aviso-sesion" class="aviso" role="status" hidden></p>
      <div class="campo">
        <label for="cuenta">Cuenta</label>
        <input id="cuenta" name="cuenta" autocomplete="username" autocapitalize="none" spellcheck="false"
          required minlength="3" maxlength="64" aria-describedby="error-acceso" />
      </div>
      <div class="campo">
        <label for="contrasena">Contraseña</label>
        <input id="contrasena" name="contrasena" type="password" autocomplete="current-password"
          required maxlength="256" aria-describedby="error-acceso" />
        <p id="error-acceso" class="error" role="alert" hidden></p>
      </div>
      <button type="submit" disabled>Iniciar sesión</button>
    </form>
    <noscript>Activa JavaScript para iniciar sesión.</noscript>
  </main>
</BaseLayout>

<script>
  import type { CuentaSesion, InicioSesion } from '@inventario/contracts';
  import { ErrorApi, solicitar } from '../lib/api';
  import { mensajeError, mostrarAviso, recargarAlVolver } from '../lib/sesion';

  const formulario = document.querySelector<HTMLFormElement>('#inicio-sesion')!;
  const boton = formulario.querySelector<HTMLButtonElement>('button')!;
  const cuenta = formulario.querySelector<HTMLInputElement>('#cuenta')!;
  const contrasena = formulario.querySelector<HTMLInputElement>('#contrasena')!;
  const aviso = document.querySelector<HTMLElement>('#aviso-sesion')!;
  const errorAcceso = document.querySelector<HTMLElement>('#error-acceso')!;

  recargarAlVolver();
  if (new URLSearchParams(location.search).get('sesion') === 'vencida') {
    mostrarAviso(aviso, 'Inicia sesión para acceder al inventario.');
  }

  formulario.addEventListener('submit', async (evento) => {
    evento.preventDefault();
    if (boton.disabled) return;
    boton.disabled = true;
    mostrarAviso(errorAcceso, '');
    cuenta.removeAttribute('aria-invalid');
    contrasena.removeAttribute('aria-invalid');

    const datos: InicioSesion = { cuenta: cuenta.value.trim(), contrasena: contrasena.value };
    try {
      await solicitar<CuentaSesion>('/sesion', 'POST', datos);
      formulario.reset();
      location.replace('/inventario/');
    } catch (error) {
      mostrarAviso(errorAcceso, mensajeError(error));
      if (error instanceof ErrorApi && error.codigo === 'datos_invalidos') {
        cuenta.setAttribute('aria-invalid', 'true');
        cuenta.focus();
      } else if (error instanceof ErrorApi && error.codigo === 'credenciales_invalidas') {
        cuenta.setAttribute('aria-invalid', 'true');
        contrasena.setAttribute('aria-invalid', 'true');
        contrasena.focus();
      }
      boton.disabled = false;
    }
  });

  solicitar<CuentaSesion>('/sesion')
    .then(() => location.replace('/inventario/'))
    .catch(() => { boton.disabled = false; });
</script>

<style>
  .acceso {
    width: min(100%, 28rem);
    margin-block: clamp(2rem, 9vh, 6rem);
  }

  .acceso-encabezado {
    padding: 1.5rem;
    margin-bottom: 1rem;
    border-radius: 1rem;
    background: var(--verde);
    color: white;
  }

  .acceso-encabezado .marca {
    color: #d8e7dd;
    margin-bottom: 0.75rem;
  }

  .acceso-encabezado h1 { color: inherit; }
</style>
